# Maintainer: Kreijstal

_realname=webots
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=R2025b.r0.gf56cc3cd4
pkgrel=2
pkgdesc="Open-source robot simulator (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64')
url="https://cyberbotics.com/"
msys2_repository_url="https://github.com/kreijstal-contributions/webots"
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-assimp"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-dlfcn"
  "${MINGW_PACKAGE_PREFIX}-ffmpeg"
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-gcc"
  "${MINGW_PACKAGE_PREFIX}-glm"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
  "${MINGW_PACKAGE_PREFIX}-ois"
  "${MINGW_PACKAGE_PREFIX}-openal"
  "${MINGW_PACKAGE_PREFIX}-openvr"
  "${MINGW_PACKAGE_PREFIX}-qt6-base"
  "${MINGW_PACKAGE_PREFIX}-qt6-declarative"
  "${MINGW_PACKAGE_PREFIX}-qt6-websockets"
  "${MINGW_PACKAGE_PREFIX}-stb"
  make
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  patch
)
_commit=f56cc3cd41bd199e6766651bb8801e5aedadb06a
_picotts_commit=d42a96fe93629202147b6e40e93133766b2229d8
_sourcedir="${_realname}-${_commit}"
_picotts_sourcedir="picotts-${_picotts_commit}"
source=(
  "${_sourcedir}.tar.gz::https://github.com/kreijstal-contributions/webots/archive/${_commit}.tar.gz"
  "${_picotts_sourcedir}.tar.gz::https://github.com/Kreijstal/picotts/archive/${_picotts_commit}.tar.gz"
  '002-use-packaged-picotts-source.patch'
  'xinput1_3-shim.c'
  'xinput1_3-shim.def'
)
sha256sums=('3cc31ddc0801e5e4437b28e4c95d0baac214f4eca2283d585c0c09f40150265c'
            '69a34a386d8c0ec378ef3e7b6e7ef2a1b0c6e26a7ca05b4e05bbb14192ea1ee0'
            'd7f4f1f4d1d83d87730ad59d0a88a49d5e141b05c6c360c3089b45915d78f43a'
            '4c95a3613f3c9fb8dc3bf9af14bc8fb574e58160f05d0829d70e38f9f5210c27'
            '1225eae3ebd93daacd4a2dce79d50859405dba1c3469dff3d286429fd82540b6')

prepare() {
  cd "${srcdir}/${_sourcedir}"

  patch -Nbp1 -i "${srcdir}/002-use-packaged-picotts-source.patch"
}

build() {
  local -a _build_type
  if check_option "debug" "n"; then
    _build_type=(-DCMAKE_BUILD_TYPE=Release)
  else
    _build_type=(-DCMAKE_BUILD_TYPE=Debug)
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DPICOTTS_SOURCE_DIR="${srcdir}/${_picotts_sourcedir}" \
      -DWEBOTS_PACKAGE_BUILD=ON \
      "${_build_type[@]}" \
      -S "${srcdir}/${_sourcedir}" \
      -B "${srcdir}/build-${MSYSTEM}"

  cmake --build "${srcdir}/build-${MSYSTEM}"

  "${CC}" -shared -o "${srcdir}/XINPUT1_3.dll" \
    "${srcdir}/xinput1_3-shim.c" "${srcdir}/xinput1_3-shim.def"
}

package() {
  DESTDIR="${pkgdir}" \
    cmake --install "${srcdir}/build-${MSYSTEM}"

  install -Dm755 "${srcdir}/XINPUT1_3.dll" \
    "${pkgdir}${MINGW_PREFIX}/bin/XINPUT1_3.dll"

  install -Dm644 "${srcdir}/${_sourcedir}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
