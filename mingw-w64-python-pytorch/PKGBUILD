# Maintainer: Kreijstal <Kreijstal@users.noreply.github.com>

_realname=pytorch
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.11.0
pkgrel=1
pkgdesc="Tensors and dynamic neural networks in Python (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url="https://pytorch.org/"
msys2_repository_url="https://github.com/pytorch/pytorch"
msys2_references=(
  "pypi: torch"
)
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-filelock"
         "${MINGW_PACKAGE_PREFIX}-python-fsspec"
         "${MINGW_PACKAGE_PREFIX}-python-jinja2"
         "${MINGW_PACKAGE_PREFIX}-python-networkx"
         "${MINGW_PACKAGE_PREFIX}-python-numpy"
         "${MINGW_PACKAGE_PREFIX}-python-optree"
         "${MINGW_PACKAGE_PREFIX}-python-sympy"
         "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
         "${MINGW_PACKAGE_PREFIX}-eigen3"
         "${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-fmt"
         "${MINGW_PACKAGE_PREFIX}-flatbuffers"
         "${MINGW_PACKAGE_PREFIX}-nlohmann-json"
         "${MINGW_PACKAGE_PREFIX}-openblas")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-benchmark"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "git"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-protobuf"
             "${MINGW_PACKAGE_PREFIX}-pybind11"
             "${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-packaging"
             "${MINGW_PACKAGE_PREFIX}-python-protobuf"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-wheel"
             "${MINGW_PACKAGE_PREFIX}-python-yaml")
options=(!strip)
source=("${_realname}::git+https://github.com/pytorch/pytorch.git#tag=v${pkgver}"
        "${_realname}-FP16::git+https://github.com/Maratyszcza/FP16.git"
        "${_realname}-FXdiv::git+https://github.com/Maratyszcza/FXdiv.git"
        "${_realname}-cpp-httplib::git+https://github.com/yhirose/cpp-httplib.git"
        "${_realname}-cpuinfo::git+https://github.com/pytorch/cpuinfo.git"
        "${_realname}-onnx::git+https://github.com/onnx/onnx.git"
        "${_realname}-pocketfft::git+https://github.com/mreineck/pocketfft.git"
        "${_realname}-psimd::git+https://github.com/Maratyszcza/psimd.git"
        "${_realname}-pthreadpool::git+https://github.com/Maratyszcza/pthreadpool.git"
        "${_realname}-sleef::git+https://github.com/shibatch/sleef.git"
        "0001-pytorch-mingw-port.patch"
        "0002-third_party-onnx-optional-macro.patch")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            '7b37b4cd7800d70d0446255444d9900d484f9df912869f0e340502b8208ecfa0'
            '5d5c8399bb8c26fba3bb8ef9cdabd6ec9c67ae289c1de4770356514469b0b952')

apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${srcdir}/${_realname}"

  git submodule init
  git config submodule."third_party/FP16".url "${srcdir}/${_realname}-FP16"
  git config submodule."third_party/FXdiv".url "${srcdir}/${_realname}-FXdiv"
  git config submodule."third_party/cpp-httplib".url "${srcdir}/${_realname}-cpp-httplib"
  git config submodule."third_party/cpuinfo".url "${srcdir}/${_realname}-cpuinfo"
  git config submodule."third_party/onnx".url "${srcdir}/${_realname}-onnx"
  git config submodule."third_party/pocketfft".url "${srcdir}/${_realname}-pocketfft"
  git config submodule."third_party/psimd".url "${srcdir}/${_realname}-psimd"
  git config submodule."third_party/pthreadpool".url "${srcdir}/${_realname}-pthreadpool"
  git config submodule."third_party/sleef".url "${srcdir}/${_realname}-sleef"

  git -c protocol.file.allow=always submodule update --init \
    third_party/FP16 \
    third_party/FXdiv \
    third_party/cpp-httplib \
    third_party/cpuinfo \
    third_party/onnx \
    third_party/pocketfft \
    third_party/psimd \
    third_party/pthreadpool \
    third_party/sleef

  apply_patch_with_msg \
    0001-pytorch-mingw-port.patch

  patch -Nbp1 -d third_party/onnx -i "${srcdir}/0002-third_party-onnx-optional-macro.patch"
}

build() {
  cd "${srcdir}/${_realname}"

  export PYTORCH_BUILD_VERSION="${pkgver}"
  export PYTORCH_BUILD_NUMBER="${pkgrel}"
  export PYTORCH_PACKAGE_USE_DECLARED_SUBMODULES=1
  export BUILD_TEST=0
  export USE_CUDA=0
  export USE_ROCM=0
  export USE_DISTRIBUTED=0
  export USE_GLOO=0
  export USE_TENSORPIPE=0
  export USE_MKLDNN=0
  export USE_NNPACK=0
  export USE_QNNPACK=0
  export USE_PYTORCH_QNNPACK=0
  export USE_XNNPACK=0
  export USE_FBGEMM=0
  export USE_KINETO=0
  export USE_OPENMP=0
  export USE_NUMA=0
  export USE_MPS=0
  export USE_XPU=0
  export USE_ITT=0
  export USE_MIMALLOC=0
  export USE_SYSTEM_BENCHMARK=1
  export USE_SYSTEM_EIGEN_INSTALL=1
  export USE_SYSTEM_PYBIND11=1
  export BUILD_CUSTOM_PROTOBUF=0
  export CAFFE2_LINK_LOCAL_PROTOBUF=0
  export BLAS=OpenBLAS
  export OpenBLAS_HOME="${MINGW_PREFIX}"
  export OpenBLAS_LIB_NAME=openblas

  ${MINGW_PREFIX}/bin/python setup.py bdist_wheel
}

package() {
  cd "${srcdir}/${_realname}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
